  ],
  [
    {
      "op": "test",
      "path": "/scenes/adultnocttop1/text",
      "value": "Fully grown Nocttops are an uncommon sight. They generally exist for the purpose of producing new Nocttops. They are, ironically, somewhat less dangerous than younger Nocttops."
    },
    {
      "op": "replace",
      "path": "/scenes/adultnocttop1/text",
      "value": "完全に成長したノクトップは珍しい光景です。 一般的に、新しいノクトップを製造するために存在します。 皮肉なことに、若いノクトップスよりもやや危険ではありません。"
    }
  ],
  [
    {
      "op": "test",
      "path": "/scenes/adultpoptop0/text",
      "value": "MONSTER: Adult Poptop - FAMILY: Poptop - SPECIES: Poptop - BIOMES: Jungle"
